                    <MudMenuItem OnClick="@(() => DeleteEmoloyee(context.Item.Id))">
                        <MudIcon Icon="@Icons.Material.Filled.Delete"/> Delete
                    </MudMenuItem>

                </MudMenu>
            </CellTemplate>

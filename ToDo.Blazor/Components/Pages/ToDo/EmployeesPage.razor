                              Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Variant="Variant.Outlined"
                              Style="height: 35px;" />
            </MudItem>
            <MudItem xs="12" sm="3" Class="align-self-end">
                <MudButton Class="mx-2" OnClick="CreateCustomer" Color="Color.Primary" Variant="Variant.Filled">Create</MudButton>
            </MudItem>
        </MudItem>
        
    </ToolBarContent>
    <Columns>

        <PropertyColumn Property="x => x.FirstName" Title="First Name" />
        <PropertyColumn Property="x => x.LastName" Title="Last Name" />
        <PropertyColumn Property="x => x.WorkPhone" Title="Work Phone"  />
        <PropertyColumn Property="x => x.Email" Title="Email"  />
        <PropertyColumn Property="x => x.Status" Title="Status" />
        <TemplateColumn Title="Actions">
           
            <CellTemplate>
